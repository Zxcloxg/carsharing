# Настройки отчёта о покрытии (ПР5): python -m coverage run manage.py test tests
[run]
source = .
branch = True
omit =
    .venv/*
    tests/*
    */migrations/*
    manage.py
    config/asgi.py
    config/wsgi.py
    security_check.py
    auth_check.py
    demo.py
    async_check.py
    payment_provider_stub.py

[report]
show_missing = True
skip_empty = True
sort = Cover
precision = 1

[html]
directory = htmlcov
title = booking-service — покрытие автотестами
