# Подключение booking-service к PostgreSQL.
# Скопируйте файл в .env и укажите свои значения; .env в git не попадает.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carsharing
DB_USER=carsharing
DB_PASSWORD=change-me

# Секрет подписи JWT, не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# Срок жизни access-токена в минутах.
JWT_ACCESS_TTL_MINUTES=60
