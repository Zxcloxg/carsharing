# Подключение booking-service к PostgreSQL.
# Скопируйте файл в .env и укажите свои значения; .env в git не попадает.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carsharing
DB_USER=carsharing
DB_PASSWORD=change-me

# Секрет подписи JWT, не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# Срок жизни access-токена в минутах.
JWT_ACCESS_TTL_MINUTES=60

# Секретный ключ Django (подпись сессий и CSRF админки), не короче 50 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
# Режим отладки: по умолчанию выключен. true — только для локальной отладки
# (подробные страницы ошибок и стили админки при runserver).
DJANGO_DEBUG=false
# Имена хостов, на которые сервис отвечает (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Число доверенных прокси перед сервисом: 0 — запросы напрямую, 1 — за API Gateway.
# От него зависит, по какому адресу считается лимит попыток входа.
TRUSTED_PROXY_COUNT=0

# Фоновые задачи (ПР6): обработчик — python manage.py run_worker (worker.cmd).
# Попыток на задачу и пауза перед повтором (удваивается: 2, 4, 8… с, но не больше максимума).
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=2
TASK_RETRY_BACKOFF_MAX_SECONDS=300
# Через сколько секунд задачу «зависшего» обработчика забирает другой.
TASK_LEASE_SECONDS=300

# Платёжный провайдер: локально — эмулятор payment_provider_stub.py (payment_provider.cmd).
PAYMENT_PROVIDER_URL=http://127.0.0.1:8030
# Тайм-аут одного вызова провайдера, с.
PAYMENT_PROVIDER_TIMEOUT=5
