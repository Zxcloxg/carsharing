# Переменные окружения для docker compose (ПР7). Скопируйте в .env и заполните; .env в git не попадает.
# Значения не приведены намеренно — каждое развёртывание получает свои.
# Сгенерировать секрет:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- база данных (контейнер db) ---
DB_NAME=carsharing
DB_USER=carsharing
# Пароль пользователя базы — задаётся и для PostgreSQL, и для сервиса.
DB_PASSWORD=

# --- секреты booking-service ---
# Ключ Django (подпись сессий и CSRF админки), не короче 50 символов.
DJANGO_SECRET_KEY=
# Ключ подписи JWT, не короче 32 символов.
JWT_SECRET=
# Токен доступа к GET /metrics (Authorization: Bearer <токен>). Пусто — метрики открыты.
METRICS_TOKEN=

# --- необязательные параметры ---
# true — при первом запуске заполнить базу демо-данными (seed_demo).
SEED_DEMO=false
# Порты на хосте.
API_PORT=8010
TELEMETRY_PORT=8020
# Повторы фоновых задач (ПР6) и задержка эмулятора провайдера, с.
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=2
PROVIDER_LATENCY=1.5
