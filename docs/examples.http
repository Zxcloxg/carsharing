#       }
#     ]
#   }
# }

###############################################################################
# 24. Та же машина клиентом без подтверждённого ВУ -> 409 (сначала проверяется машина)
###############################################################################
POST {{host}}/api/v1/bookings
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"car_id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8", "customer_phone": "+77071112233"}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "car_not_available",
#     "message": "Car is not available for booking",
#     "details": [
#       {
#         "field": "car_id",
#         "message": "Car status is booked"
#       }
#     ]
#   }
# }

###############################################################################
# 25. Удаление машины с историей аренд (FK ON DELETE PROTECT)
###############################################################################
DELETE {{host}}/api/v1/cars/e744cdeb-9535-43ac-ad59-7a1e6a2096a8
Authorization: Bearer {{admin_token}}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "car_has_bookings",
