###############################################################################
### ПР4: регистрация и вход, проверка токена, роли и права владельца,
### единый формат ошибок {"error": {"code", "message", "details"}}
###############################################################################

###############################################################################
# 33. Регистрация: роль всегда customer, пароль хранится только в виде хэша Argon2id
###############################################################################
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "newuser5318@example.kz",
  "password": "Tiger#Moon2026"
}

# HTTP/1.1 201 Created
# Location: /api/v1/users/1cc4e5aa-8300-40dc-ac9b-2c3a5c62fa54
# {
#   "id": "1cc4e5aa-8300-40dc-ac9b-2c3a5c62fa54",
#   "email": "newuser5318@example.kz",
#   "role": "customer",
#   "customer_id": null,
#   "is_active": true,
#   "created_at": "2026-10-21T07:37:31.257756+00:00",
#   "last_login_at": null
# }

###############################################################################
# 34. Повторная регистрация того же email в другом регистре -> 409
###############################################################################
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "NEWUSER5318@EXAMPLE.KZ",
  "password": "Tiger#Moon2026"
}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "email_taken",
