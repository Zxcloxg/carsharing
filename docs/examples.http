### Примеры запросов и ответов: /api/v1/cars (ПР2), клиенты, брони и платежи (ПР3),
### аутентификация, роли и единый формат ошибок (ПР4)
#
# Файл в формате .http: открывается в VS Code (REST Client), JetBrains IDE,
# либо выполняется вручную через curl (команда приведена перед каждым блоком).
# Все ответы ниже — реальные, сняты с запущенного booking-service.
#
# Запуск сервиса:  cd booking-service && python manage.py runserver 8010

@host = http://localhost:8010

# С ПР4 изменяющие запросы требуют токен. Сначала выполните два запроса входа
# ниже: REST Client подставит токены в переменные admin_token и customer_token.
# Для curl добавьте -H "Authorization: Bearer <access_token>".
# Ответы с ошибками в разделах ПР2–ПР3 приведены к формату ПР4.

# @name adminLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{"email": "admin@carsharing.kz", "password": "Steppe#Falcon2026"}

###
# @name customerLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{"email": "aigerim@example.kz", "password": "Tulip#Morning2026"}

###
@admin_token = {{adminLogin.response.body.$.access_token}}
@customer_token = {{customerLogin.response.body.$.access_token}}

###############################################################################
# 0. Проверка живости
# curl -s http://localhost:8010/health
###############################################################################
GET {{host}}/health

# HTTP/1.1 200 OK
# {
#   "status": "ok",
#   "service": "booking-service",
#   "framework": "django",
#   "time": "2026-09-16T03:21:28.315865+00:00"
# }

###############################################################################
# 1. Список машин с пагинацией и фильтром по статусу
# curl -s "http://localhost:8010/api/v1/cars?page=1&limit=2&status=free"
###############################################################################
GET {{host}}/api/v1/cars?page=1&limit=2&status=free

# HTTP/1.1 200 OK
# {
#   "items": [
#     {
#       "plate": "123ABC02", "brand": "Kia", "model": "Rio", "year": 2022,
#       "color": "white", "price_per_minute": 65, "fuel_level": 0.8,
#       "status": "free", "id": "79310f51-8ade-4954-96e3-a65a534347c0",
#       "created_at": "2026-09-16T03:21:19.619587+00:00",
#       "updated_at": "2026-09-16T03:21:19.619587+00:00"
#     },
#     {
#       "plate": "456DEF02", "brand": "Hyundai", "model": "Creta", "year": 2023,
#       "color": "grey", "price_per_minute": 95, "fuel_level": 0.55,
#       "status": "free", "id": "719d1c7b-f8db-4d24-8b82-6f1197714482",
#       "created_at": "2026-09-16T03:21:19.619587+00:00",
#       "updated_at": "2026-09-16T03:21:19.619587+00:00"
#     }
#   ],
#   "page": 1, "limit": 2, "total": 2, "pages": 1
# }

###############################################################################
# 2. Фильтр по марке и по цене
# curl -s "http://localhost:8010/api/v1/cars?brand=kia&max_price_per_minute=70"
###############################################################################
GET {{host}}/api/v1/cars?brand=kia&max_price_per_minute=70

# HTTP/1.1 200 OK
# {
#   "items": [
#     {
#       "plate": "123ABC02", "brand": "Kia", "model": "Rio", "year": 2022,
#       "color": "white", "price_per_minute": 65, "fuel_level": 0.8,
#       "status": "free", "id": "79310f51-8ade-4954-96e3-a65a534347c0",
#       "created_at": "2026-09-16T03:21:19.619587+00:00",
#       "updated_at": "2026-09-16T03:21:19.619587+00:00"
#     }
#   ],
#   "page": 1, "limit": 10, "total": 1, "pages": 1
# }

###############################################################################
# 3. Создание машины
# curl -s -X POST http://localhost:8010/api/v1/cars -H "Content-Type: application/json" \
#   -d '{"plate":"555XYZ02","brand":"Toyota","model":"Camry","year":2024,"color":"black","price_per_minute":120,"fuel_level":0.95}'
###############################################################################
POST {{host}}/api/v1/cars
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "plate": "555XYZ02",
  "brand": "Toyota",
  "model": "Camry",
  "year": 2024,
  "color": "black",
  "price_per_minute": 120,
  "fuel_level": 0.95
}

# HTTP/1.1 201 Created
# Location: /api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
# {
#   "plate": "555XYZ02", "brand": "Toyota", "model": "Camry", "year": 2024,
#   "color": "black", "price_per_minute": 120.0, "fuel_level": 0.95,
#   "status": "free", "id": "037324ab-f820-4d62-be1b-e06b9bc38da6",
#   "created_at": "2026-09-16T03:21:39.626673+00:00",
#   "updated_at": "2026-09-16T03:21:39.626673+00:00"
# }

###############################################################################
# 4. Получение одной машины
# curl -s http://localhost:8010/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
###############################################################################
GET {{host}}/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6

# HTTP/1.1 200 OK
# {
#   "plate": "555XYZ02", "brand": "Toyota", "model": "Camry", "year": 2024,
#   "color": "black", "price_per_minute": 120.0, "fuel_level": 0.95,
#   "status": "free", "id": "037324ab-f820-4d62-be1b-e06b9bc38da6",
#   "created_at": "2026-09-16T03:21:39.626673+00:00",
#   "updated_at": "2026-09-16T03:21:39.626673+00:00"
# }

###############################################################################
# 5. Полная замена (PUT): сменили модель, год, цвет и тариф
# curl -s -X PUT http://localhost:8010/api/v1/cars/037324ab-... -H "Content-Type: application/json" -d '{...}'
###############################################################################
PUT {{host}}/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "plate": "555XYZ02",
  "brand": "Toyota",
  "model": "Camry 70",
  "year": 2025,
  "color": "white",
  "price_per_minute": 135,
  "fuel_level": 0.6,
  "status": "free"
}

# HTTP/1.1 200 OK
# {
#   "plate": "555XYZ02", "brand": "Toyota", "model": "Camry 70", "year": 2025,
#   "color": "white", "price_per_minute": 135.0, "fuel_level": 0.6,
#   "status": "free", "id": "037324ab-f820-4d62-be1b-e06b9bc38da6",
#   "created_at": "2026-09-16T03:21:39.626673+00:00",   <- не меняется
#   "updated_at": "2026-09-16T03:21:53.762340+00:00"    <- обновилось
# }

###############################################################################
# 6. Частичное обновление (PATCH): машина уехала на обслуживание
# curl -s -X PATCH http://localhost:8010/api/v1/cars/037324ab-... -H "Content-Type: application/json" \
#   -d '{"status":"service","fuel_level":0.1}'
###############################################################################
PATCH {{host}}/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "status": "service",
  "fuel_level": 0.1
}

# HTTP/1.1 200 OK
# {
#   "plate": "555XYZ02", "brand": "Toyota", "model": "Camry 70", "year": 2025,
#   "color": "white", "price_per_minute": 135.0, "fuel_level": 0.1,
#   "status": "service", "id": "037324ab-f820-4d62-be1b-e06b9bc38da6",
#   "created_at": "2026-09-16T03:21:39.626673+00:00",
#   "updated_at": "2026-09-16T03:21:54.138418+00:00"
# }

###############################################################################
# 7. Удаление
# curl -s -X DELETE http://localhost:8010/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
###############################################################################
DELETE {{host}}/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6
Authorization: Bearer {{admin_token}}

# HTTP/1.1 204 No Content
# (тела ответа нет)

###############################################################################
# 8. Обращение к удалённой машине -> 404 в едином формате ошибок
###############################################################################
GET {{host}}/api/v1/cars/037324ab-f820-4d62-be1b-e06b9bc38da6

# HTTP/1.1 404 Not Found
# {
#   "error": {
#     "code": "car_not_found",
#     "message": "Car not found",
#     "details": [
#       {"field": "id", "message": "No car with id 037324ab-f820-4d62-be1b-e06b9bc38da6"}
#     ]
#   }
# }

###############################################################################
# 9. Валидация: неверный формат номера, нет обязательного поля,
#    неверный тип года, неположительный тариф -> 400, а не 500
# curl -s -X POST http://localhost:8010/api/v1/cars -H "Content-Type: application/json" \
#   -d '{"plate":"bad!","model":"Rio","year":"recently","price_per_minute":0}'
###############################################################################
POST {{host}}/api/v1/cars
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "plate": "bad!",
  "model": "Rio",
  "year": "recently",
  "price_per_minute": 0
}

# HTTP/1.1 400 Bad Request
# {
#   "error": {
#     "code": "validation_error",
#     "message": "Validation failed",
#     "details": [
#       {"field": "plate", "message": "This value does not match the required pattern."},
#       {"field": "brand", "message": "This field is required."},
#       {"field": "year", "message": "A valid integer is required."},
#       {"field": "price_per_minute", "message": "Ensure this value is greater than or equal to 0.01."}
#     ]
#   }
# }

###############################################################################
# 10. Валидация: пустое обязательное поле
###############################################################################
POST {{host}}/api/v1/cars
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "plate": "777QQQ02",
  "brand": "",
  "model": "Rio",
  "year": 2022,
  "price_per_minute": 70
}

# HTTP/1.1 400 Bad Request
# {
#   "error": {
#     "code": "validation_error",
#     "message": "Validation failed",
#     "details": [
#       {"field": "brand", "message": "This field may not be blank."}
#     ]
#   }
# }

###############################################################################
# 11. Бизнес-правило: госномер уже занят -> 409
###############################################################################
POST {{host}}/api/v1/cars
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "plate": "123ABC02",
  "brand": "Kia",
  "model": "Rio",
  "year": 2022,
  "price_per_minute": 65
}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "plate_already_used",
#     "message": "Car with this plate already exists",
#     "details": [
#       {"field": "plate", "message": "Plate 123ABC02 is already registered"}
#     ]
#   }
# }

###############################################################################
# 12. Валидация query-параметров: неизвестный статус в фильтре
###############################################################################
GET {{host}}/api/v1/cars?status=flying

# HTTP/1.1 400 Bad Request
# {
#   "error": {
#     "code": "validation_error",
#     "message": "Validation failed",
#     "details": [
#       {"field": "status", "message": "\"flying\" is not a valid choice."}
#     ]
#   }
# }


###############################################################################
###############################################################################
### ПР3: полная база данных (10 таблиц), клиенты и ВУ, аренда с оплатой,
### сохранность данных между перезапусками
#
# Ответы сняты 2026-10-07 с booking-service, подключённого к PostgreSQL 17.6,
# после python manage.py migrate и seed_demo. Все запросы ПР2 (блоки 0–12)
# повторены поверх базы и дают те же ответы; ниже — новые сценарии.
###############################################################################

###############################################################################
# 13. Регистрация клиента
###############################################################################
POST {{host}}/api/v1/customers
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"phone": "+77051234567", "full_name": "Тимур Нурланов", "birth_date": "1997-02-14", "email": "timur@example.kz"}

# HTTP/1.1 201 Created
# Location: /api/v1/customers/2d91f08b-cc69-4e80-89f3-778abe640642
# {
#   "id": "2d91f08b-cc69-4e80-89f3-778abe640642",
#   "phone": "+77051234567",
#   "email": "timur@example.kz",
#   "full_name": "Тимур Нурланов",
#   "status": "active",
#   "birth_date": "1997-02-14",
#   "has_valid_license": false,
#   "created_at": "2026-10-07T08:34:29.547576+00:00"
# }

###############################################################################
# 14. Повторная регистрация с тем же телефоном (UNIQUE customers.phone)
###############################################################################
POST {{host}}/api/v1/customers
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"phone": "+77051234567", "full_name": "Другой Клиент", "birth_date": "1990-01-01"}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "phone_already_used",
#     "message": "Customer with this phone already exists",
#     "details": [
#       {
#         "field": "phone",
#         "message": "Phone +77051234567 is already registered"
#       }
#     ]
#   }
# }

###############################################################################
# 15. Регистрация с ошибками: телефон, имя, клиенту меньше 18 лет
###############################################################################
POST {{host}}/api/v1/customers
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"phone": "12", "full_name": "Я", "birth_date": "2015-01-01"}

# HTTP/1.1 400 Bad Request
# {
#   "error": {
#     "code": "validation_error",
#     "message": "Validation failed",
#     "details": [
#       {
#         "field": "phone",
#         "message": "This value does not match the required pattern."
#       },
#       {
#         "field": "full_name",
#         "message": "Ensure this field has at least 2 characters."
#       },
#       {
#         "field": "birth_date",
#         "message": "Customer must be at least 18 years old"
#       }
#     ]
#   }
# }

###############################################################################
# 16. Подача водительского удостоверения на проверку
###############################################################################
POST {{host}}/api/v1/customers/2d91f08b-cc69-4e80-89f3-778abe640642/driver-licenses
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"number": "KZ5551234", "categories": "B", "issued_on": "2017-08-10", "expires_on": "2027-08-10"}

# HTTP/1.1 201 Created
# Location: /api/v1/driver-licenses/62785fee-5f79-421e-8813-6196c0a29b8f
# {
#   "id": "62785fee-5f79-421e-8813-6196c0a29b8f",
#   "customer_id": "2d91f08b-cc69-4e80-89f3-778abe640642",
#   "number": "KZ5551234",
#   "categories": "B",
#   "status": "pending",
#   "reject_reason": null,
#   "issued_on": "2017-08-10",
#   "expires_on": "2027-08-10",
#   "submitted_at": "2026-10-07T08:34:30.002425+00:00",
#   "reviewed_at": null
# }

###############################################################################
# 17. Вторая заявка, пока первая на проверке (частичный UNIQUE driver_licenses)
###############################################################################
POST {{host}}/api/v1/customers/2d91f08b-cc69-4e80-89f3-778abe640642/driver-licenses
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"number": "KZ5559999", "categories": "B", "issued_on": "2017-08-10", "expires_on": "2027-08-10"}

# HTTP/1.1 409 Conflict
# {
#   "error": {
#     "code": "license_already_submitted",
#     "message": "Driver license is already submitted",
#     "details": [
#       {
#         "field": "customer_id",
#         "message": "Customer already has a pending or approved license"
#       }
#     ]
#   }
# }

###############################################################################
# 18. Создание машины: brand/model уходят в справочник car_models
###############################################################################
POST {{host}}/api/v1/cars
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"plate": "555XYZ02", "brand": "Toyota", "model": "Camry", "year": 2024, "color": "black", "price_per_minute": 120, "fuel_level": 0.95}

# HTTP/1.1 201 Created
# Location: /api/v1/cars/e744cdeb-9535-43ac-ad59-7a1e6a2096a8
# {
#   "plate": "555XYZ02",
#   "brand": "Toyota",
#   "model": "Camry",
#   "year": 2024,
#   "color": "black",
#   "price_per_minute": 120.0,
#   "fuel_level": 0.95,
#   "status": "free",
#   "id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8",
#   "created_at": "2026-10-07T08:34:30.343164+00:00",
#   "updated_at": "2026-10-07T08:34:30.343164+00:00"
# }

###############################################################################
# 19. Бронирование до подтверждения ВУ -> 403
###############################################################################
POST {{host}}/api/v1/bookings
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"car_id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8", "customer_phone": "+77051234567"}

# HTTP/1.1 403 Forbidden
# {
#   "error": {
#     "code": "customer_cannot_rent",
#     "message": "Customer is not allowed to rent",
#     "details": [
#       {
#         "field": "customer_phone",
#         "message": "Driver license is not verified or expired"
#       }
#     ]
#   }
# }

###############################################################################
# 20. Оператор подтверждает удостоверение
###############################################################################
PATCH {{host}}/api/v1/driver-licenses/62785fee-5f79-421e-8813-6196c0a29b8f
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"status": "approved"}

# HTTP/1.1 200 OK
# {
#   "id": "62785fee-5f79-421e-8813-6196c0a29b8f",
#   "customer_id": "2d91f08b-cc69-4e80-89f3-778abe640642",
#   "number": "KZ5551234",
#   "categories": "B",
#   "status": "approved",
#   "reject_reason": null,
#   "issued_on": "2017-08-10",
#   "expires_on": "2027-08-10",
#   "submitted_at": "2026-10-07T08:34:30.002425+00:00",
#   "reviewed_at": "2026-10-07T08:34:30.646883+00:00"
# }

###############################################################################
# 21. Клиент допущен к аренде
###############################################################################
GET {{host}}/api/v1/customers/2d91f08b-cc69-4e80-89f3-778abe640642
Authorization: Bearer {{admin_token}}

# HTTP/1.1 200 OK
# {
#   "id": "2d91f08b-cc69-4e80-89f3-778abe640642",
