###############################################################################
# 37. Вход: верный пароль -> access-токен (JWT, 60 минут)
###############################################################################
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "newuser5318@example.kz",
  "password": "Tiger#Moon2026"
}

