###############################################################################
# 22. Бронирование (транзакция: bookings + cars + car_status_history)
###############################################################################
POST {{host}}/api/v1/bookings
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"car_id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8", "customer_phone": "+77051234567"}

# HTTP/1.1 201 Created
# Location: /api/v1/bookings/8cf7ea87-1924-4d3d-ab4c-c67a0ff2b7a4
# {
#   "id": "8cf7ea87-1924-4d3d-ab4c-c67a0ff2b7a4",
#   "car_id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8",
#   "customer_id": "2d91f08b-cc69-4e80-89f3-778abe640642",
#   "customer_phone": "+77051234567",
#   "status": "active",
#   "price_per_minute": 135.0,
#   "total_cost": null,
#   "started_at": "2026-10-07T08:34:32.312688+00:00",
#   "finished_at": null
# }

###############################################################################
# 23. Та же машина другим клиентом -> 409
###############################################################################
POST {{host}}/api/v1/bookings
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"car_id": "e744cdeb-9535-43ac-ad59-7a1e6a2096a8", "customer_phone": "+77027654321"}

# HTTP/1.1 409 Conflict
# {
#   "error": {
