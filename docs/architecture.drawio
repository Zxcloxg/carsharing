          <mxGeometry x="920" y="165" width="110" height="110" as="geometry" />
        </mxCell>

        <mxCell id="telemetry" value="telemetry-service · Flask&#10;&#10;Приём телеметрии от машин,&#10;актуальные координаты и статус,&#10;поиск ближайших свободных авто" style="rounded=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#7c2d12;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
